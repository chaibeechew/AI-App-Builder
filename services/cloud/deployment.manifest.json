{
  "service":"laneriq-cloud-data",
  "contract":"csvc1",
  "root":"services/cloud",
  "deploymentModes":["embedded","remote","device"],
  "requiredEnvironment":["LANERIQ_CLOUD_STORAGE_ADAPTER_URL"],
  "requiredAnyOf":[["LANERIQ_CLOUD_STORAGE_ADAPTER_SECRET","LANERIQ_CLOUD_SERVICE_SECRET"]],
  "optionalEnvironment":["LANERIQ_CLOUD_SERVICE_SECRET","LANERIQ_CLOUD_STORAGE_ADAPTER_SECRET"],
  "peerAuthentication":{"preferred":"VERCEL_OIDC","fallback":"HMAC_SHA256","productionSourceProject":"laneriq-ai","productionEnvironment":"production","sharedPeerSecretRequired":false},
  "adapterAuthentication":"dedicated adapter secret when supplied, otherwise LANERIQ Cloud service secret",
  "security":{"httpsOnly":true,"signedInbound":true,"oidcIdentityVerification":true,"tripleScopeRequired":true,"arbitraryQueryAllowed":false,"rawProviderCredentialsForbidden":true,"silentEmbeddedFallback":false},
  "cost":{"fixedInfrastructureRequired":false,"automaticPaidEscalation":false},
  "evidence":{"codeReady":true,"standaloneLive":false,"signedCanaryRequired":true,"secretlessPeerCanaryRequiredForOidcLive":true}
}
