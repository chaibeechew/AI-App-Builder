# LANERIQ Communications Service — server-side only
# Never commit real values. Never expose these through NEXT_PUBLIC_* variables except the public Supabase URL when required.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY
LANERIQ_COMMUNICATIONS_SERVICE_SECRET=replace-with-random-secret-minimum-32-characters
LANERIQ_COMMUNICATIONS_SERVICE_CLIENT_ID=laneriq-ai

# Optional after the second Project exists. Used by LANERIQ AI caller, not by the standalone service itself:
# LANERIQ_COMMUNICATIONS_SERVICE_URL=https://communications.example.com
