NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Free-tier text providers. Add only providers Soolen is authorized to use.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OLLAMA_BASE_URL=
SOOLEN_FREE_PROVIDERS=gemini,groq,cerebras,ollama

# Paid multi-model routing. Choose a current model from the provider catalog;
# do not copy a ChatGPT subscription token or expose this key to the browser.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
OPENAI_API_KEY=
SOOLEN_PAID_PROVIDERS=gateway,openai,xai,deepseek,mistral,together,openrouter,gemini,groq,cerebras,ollama

# Optional premium image integration (shown as integration-ready until its worker is connected).
SOOLEN_IMAGE_PROVIDER_URL=
SOOLEN_IMAGE_MODEL=

# Server-only SoolenAI voice
SOOLENAI_VOICE_PROVIDER=open_source
SOOLENAI_TTS_URL=https://YOUR-VOICE-SERVICE/tts
SOOLENAI_TTS_TOKEN=
SOOLENAI_VOICE_SAMPLE_URL=https://PRIVATE-SIGNED-URL/soolenai-voice.wav
# Optional paid neural voice fallback
ELEVENLABS_API_KEY=
SOOLENAI_VOICE_ID=
SPEECH_MODEL=

# Optional paid Soolen video runtime
SOOLEN_VIDEO_RUNTIME_URL=
SOOLEN_VIDEO_RUNTIME_KEY=

# Future permission-scoped capability workers
SOOLEN_WEB_SEARCH_URL=
SOOLEN_DOCUMENT_WORKER_URL=
SOOLEN_AUTOMATION_WORKER_URL=
SOOLEN_CONNECTOR_BROKER_URL=
