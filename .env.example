NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# STRICT ZERO-COST MODE
# Metered cloud providers remain blocked even if a key exists.
SOOLEN_COST_MODE=zero
SOOLEN_ZERO_COST_PROVIDERS=ollama,soolen-local
SOOLEN_FREE_PROVIDERS=ollama,soolen-local
SOOLEN_PAID_PROVIDERS=ollama,soolen-local

# Optional self-hosted local model. If absent, Soolen rules-v1 remains available.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# Optional self-hosted speech workers
SOOLEN_STT_URL=
SOOLEN_STT_TOKEN=
SOOLENAI_VOICE_PROVIDER=open_source
SOOLENAI_TTS_URL=
SOOLENAI_TTS_TOKEN=
SOOLENAI_VOICE_SAMPLE_URL=https://PRIVATE-SIGNED-URL/soolenai-voice.wav

# Device video is used in zero-cost mode; cloud rendering stays disabled.
SOOLEN_VIDEO_RUNTIME_URL=
SOOLEN_VIDEO_RUNTIME_KEY=

# These metered integrations are intentionally ignored while SOOLEN_COST_MODE=zero.
# Change cost mode deliberately before enabling any of them.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SOOLENAI_VOICE_ID=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Future permission-scoped local workers
SOOLEN_DOCUMENT_WORKER_URL=
SOOLEN_CONNECTOR_BROKER_URL=
