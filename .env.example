NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Authentication choices shown to customers: Email Code + Meta WhatsApp Code only.
# Keep false until Meta WhatsApp Cloud API and the Supabase Auth Hook are both verified.
# There is no paid SMS fallback.
NEXT_PUBLIC_WHATSAPP_AUTH_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Soolen AI cost policy. Keep "zero" for local-only operation. Use "free"
# only for provider accounts that have billing and auto-top-up disabled.
SOOLEN_COST_MODE=zero
SOOLEN_ZERO_COST_PROVIDERS=ollama,soolen-local
SOOLEN_FREE_TIER_PROVIDERS=openrouter,groq,gemini,cloudflare,huggingface,ollama,soolen-local

# Free-tier provider rotation (server-only secrets)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_FREE_MODEL=gemini-3-flash-preview
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_FREE_MODEL=@cf/zai-org/glm-4.7-flash
HF_TOKEN=
HF_MODEL=

# Guaranteed local fallbacks
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# Optional paid providers. Leave empty in zero/free mode.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=

# Optional provider-neutral commercial image runtime.
# COST_CLASS must describe the real billing behavior: zero, free or metered.
# In SOOLEN_COST_MODE=zero, anything except cost class "zero" is blocked.
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_TOKEN=
IMAGE_GENERATION_COST_CLASS=metered

# Optional provider-neutral final MP4 renderer.
# The render endpoint accepts a versioned EDL JSON payload; the status endpoint
# may contain {jobId}. Never label a paid renderer as zero-cost.
VIDEO_RENDER_PROVIDER=
VIDEO_RENDER_ENDPOINT=
VIDEO_RENDER_STATUS_ENDPOINT=
VIDEO_RENDER_TOKEN=
VIDEO_RENDER_COST_CLASS=metered

# Optional host allowlist shared by Soolen external runtimes. Comma-separated hosts.
# When set, image/video runtime endpoints outside this list are rejected.
SOOLEN_RUNTIME_HOST_ALLOWLIST=

# Server-only SoolenAI Voice
SOOLENAI_VOICE_PROVIDER=open_source
SOOLENAI_TTS_URL=https://YOUR-VOICE-SERVICE/tts
SOOLENAI_TTS_TOKEN=your_private_service_token
SOOLENAI_VOICE_SAMPLE_URL=https://PRIVATE-SIGNED-URL/soolenai-voice.wav
# Optional paid fallback; leave unset while ElevenLabs is on hold.
# ELEVENLABS_API_KEY=
# SOOLENAI_VOICE_ID=

# Cloudflare Registrar beta integration (server-only).
# Use a dedicated token with Registrar permissions; do not reuse the AI token.
CLOUDFLARE_REGISTRAR_ACCOUNT_ID=
CLOUDFLARE_REGISTRAR_API_TOKEN=
# Comma-separated operator emails that may access billable domain actions.
DOMAIN_REGISTRAR_ALLOWED_EMAILS=
# Fail closed by default. Set true only after Cloudflare billing/contact setup is reviewed.
DOMAIN_REGISTRAR_PURCHASE_ENABLED=false
# Safety cap applied to USD registrations before any billable provider call.
DOMAIN_REGISTRAR_MAX_USD=25
