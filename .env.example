NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Keep false until a paid SMS provider is intentionally enabled in Supabase Auth.
NEXT_PUBLIC_SMS_AUTH_ENABLED=false

# Soolen AI cost policy. Keep "zero" for local-only operation. Use "free"
# only for provider accounts that have billing and auto-top-up disabled.
SOOLEN_COST_MODE=zero
SOOLEN_ZERO_COST_PROVIDERS=ollama,soolen-local
SOOLEN_FREE_TIER_PROVIDERS=openrouter,groq,gemini,cloudflare,huggingface,ollama,soolen-local

# Free-tier provider rotation (server-only secrets)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_FREE_MODEL=gemini-3-flash-preview
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_FREE_MODEL=@cf/zai-org/glm-4.7-flash
HF_TOKEN=
HF_MODEL=

# Guaranteed local fallbacks
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# Optional paid providers. Leave empty in zero/free mode.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=

# Server-only SoolenAI Voice
SOOLENAI_VOICE_PROVIDER=open_source
SOOLENAI_TTS_URL=https://YOUR-VOICE-SERVICE/tts
SOOLENAI_TTS_TOKEN=your_private_service_token
SOOLENAI_VOICE_SAMPLE_URL=https://PRIVATE-SIGNED-URL/soolenai-voice.wav
# Optional paid fallback; leave unset while ElevenLabs is on hold.
# ELEVENLABS_API_KEY=
# SOOLENAI_VOICE_ID=
