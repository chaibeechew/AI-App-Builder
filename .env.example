NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# STRICT ZERO-COST MODE
# Metered cloud providers remain blocked even if a key exists.
SOOLEN_COST_MODE=zero
SOOLEN_ZERO_COST_PROVIDERS=ollama,soolen-local
SOOLEN_FREE_PROVIDERS=ollama,soolen-local
SOOLEN_PAID_PROVIDERS=ollama,soolen-local

# OPTIONAL FREE-TIER ROTATION
# After creating free accounts with billing/auto-top-up disabled, change
# SOOLEN_COST_MODE to "free" and add only the credentials you own below.
# Quota errors automatically cool that provider down; Soolen always ends at
# Ollama or rules-v1 so Generate/Modify do not stop.
SOOLEN_FREE_TIER_PROVIDERS=openrouter,groq,gemini,cloudflare,huggingface,ollama,soolen-local

# OpenRouter Free Router (the code forces openrouter/free in free mode)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq Free tier
GROQ_API_KEY=
GROQ_FREE_MODEL=openai/gpt-oss-20b

# Google Gemini API Free tier
GEMINI_API_KEY=
GEMINI_FREE_MODEL=gemini-3-flash-preview

# Cloudflare Workers AI Free allocation
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_FREE_MODEL=@cf/zai-org/glm-4.7-flash

# Hugging Face monthly free inference credit. Select a currently available
# chat-completion model in the HF playground before setting HF_MODEL.
HF_TOKEN=
HF_MODEL=

# Optional self-hosted local model. If absent, Soolen rules-v1 remains available.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# Optional self-hosted speech workers
SOOLEN_STT_URL=
SOOLEN_STT_TOKEN=
SOOLENAI_VOICE_PROVIDER=open_source
SOOLENAI_TTS_URL=
SOOLENAI_TTS_TOKEN=
SOOLENAI_VOICE_SAMPLE_URL=https://PRIVATE-SIGNED-URL/soolenai-voice.wav

# Device video is used in zero-cost mode; cloud rendering stays disabled.
SOOLEN_VIDEO_RUNTIME_URL=
SOOLEN_VIDEO_RUNTIME_KEY=

# These metered integrations are intentionally ignored while SOOLEN_COST_MODE=zero.
# Change cost mode deliberately before enabling any of them.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SOOLENAI_VOICE_ID=
CEREBRAS_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Future permission-scoped local workers
SOOLEN_DOCUMENT_WORKER_URL=
SOOLEN_CONNECTOR_BROKER_URL=
